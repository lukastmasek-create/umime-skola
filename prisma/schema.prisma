generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Auth (NextAuth / Auth.js) ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String? // hashed password, for credentials login
  role          Role      @default(STUDENT)

  // Bodový systém — aktuální zůstatek bodů. Historie je v PointTransaction,
  // takže sem lze později přidat odznaky, žebříčky, odměny apod.
  points Int @default(0)

  // Kdy uživatel naposledy roztočil kolo štěstí v obchodě (pro denní limit).
  lastWheelSpinAt DateTime?

  // Škola hráče pro školní žebříčky.
  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  // Vybraný avatar (id z src/lib/avatars.ts). Fotky se nenahrávají.
  avatar   String?
  title    String?
  xpEvents XpEvent[]
  unlocks     Unlock[]
  escapeRuns  EscapeRun[]
  idleStates  IdleState[]
  groupMemberships GroupMember[]
  ownedGroups      Group[]        @relation("GroupOwner")
  duelsStarted     Duel[]         @relation("DuelChallenger")
  duelsReceived    Duel[]         @relation("DuelOpponent")
  leagueEntries    LeagueEntry[]
  questionSets QuestionSet[]
  hostedRooms  LiveRoom[]
  livePlayers  LivePlayer[]

  accounts Account[]
  sessions Session[]

  enrollments      Enrollment[]
  progress         LessonProgress[]
  pointTransactions PointTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

// Zkušenosti (XP) pro úrovně. XP je součet všech záznamů hráče, takže se
// nikdy nesnižuje utrácením bodů a dá se u každého záznamu dohledat zdroj
// (kolo štěstí, hra, test…) a hlídat denní limity.
model XpEvent {
  id        String   @id @default(cuid())
  amount    Int
  source    String
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Odemčené odměny (avatary a tituly získané událostmi nebo úspěchy).
// `key` má tvar "avatar:chemik" nebo "title:heisenberg".
model Unlock {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

// Jeden dokončený pokus o únikovku (pro žebříčky nejrychlejších časů).
model EscapeRun {
  id        String   @id @default(cuid())
  room      String
  seconds   Int
  stars     Int
  mistakes  Int
  hints     Int
  relaxed   Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, room])
  @@index([room, seconds])
}

// Uložený postup ve stálé hře (Mazlíčci, později Základna, Farma, Město).
// `game` je id hry, `data` je JSON stav, který si hra sama validuje.
model IdleState {
  id        String   @id @default(cuid())
  game      String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, game])
}

// Parta (třída nebo kamarádi) se společným týdenním cílem. Do party se vstupuje
// kódem, `code` je krátký a unikátní.
model Group {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())

  ownerId String
  owner   User          @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members GroupMember[]
}

model GroupMember {
  id       String   @id @default(cuid())
  joinedAt DateTime @default(now())

  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

// Týdenní souboj dvou hráčů: vyhrává víc XP za učení a hraní v okně startsAt až endsAt.
// status: "pending" (čeká na přijetí), "active" (běží nebo skončil), "declined".
model Duel {
  id        String    @id @default(cuid())
  status    String    @default("pending")
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())

  challengerId String
  challenger   User   @relation("DuelChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponentId   String
  opponent     User   @relation("DuelOpponent", fields: [opponentId], references: [id], onDelete: Cascade)

  @@index([challengerId])
  @@index([opponentId])
}

// Řádek ligy hráče pro jeden týden (weekKey = datum pondělí). Liga týdne = všichni
// se stejným weekKey a tier, rozdělení do skupin po 30 podle hashe. Řádky se nemění,
// takže jde vždy zpětně spočítat, kdo postoupil a kdo sestoupil.
model LeagueEntry {
  id      String @id @default(cuid())
  weekKey String
  tier    Int    @default(0)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekKey])
  @@index([weekKey, tier])
}

// Škola pro školní žebříčky (lokální žebříček i škola vs škola). `city` je
// prázdný řetězec, když ho hráč nevyplní, aby šlo hlídat unikátnost.
model School {
  id        String   @id @default(cuid())
  name      String
  city      String   @default("")
  createdAt DateTime @default(now())

  users User[]

  @@unique([name, city])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Education domain ---

// Sekce webu: základní škola, střední škola, přípravy na přijímačky, maturita.
enum Category {
  ZAKLADNI
  STREDNI
  PRIJIMACKY
  MATURITA
}

// Jazyky/předměty, podle kterých lze kurzy filtrovat. Snadno rozšiřitelné
// o další zkratky podle potřeby.
enum Language {
  CJ // Český jazyk
  NJ // Německý jazyk
  RS // Ruský jazyk
  AJ // Anglický jazyk
}

// Předmět, pod který kurz spadá (záložky uvnitř sekce typu školy).
enum Subject {
  CESTINA
  LITERATURA
  ANGLICTINA
  NEMCINA
  RUSTINA
  MATEMATIKA
  DEJEPIS
  ZEMEPIS
  PRIRODOPIS
  FYZIKA
}

// Kurz = jedno téma (např. "i/y", "Druhá světová válka", "Savci"), které se
// procvičuje hrou. `section` je kategorie/obor uvnitř předmětu.
model Course {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String?
  published   Boolean   @default(false)
  category    Category
  language    Language?
  subject     Subject?
  section     String?
  grade       Int?

  levels      Level[]
  lessons     Lesson[]
  questions   Question[]
  enrollments Enrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, language])
  @@index([category, subject])
  @@index([category, grade])
}

// Otázka kurzu používaná hrami (Space Invaders atd.). `options` má 4 možnosti,
// `correctIndex` je index správné, `explanation` vysvětluje proč.
model Question {
  id           String   @id @default(cuid())
  prompt       String
  options      String[]
  correctIndex Int
  explanation  String
  difficulty   Int      @default(1)
  answers      String[]
  hint         String?
  order        Int      @default(0)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  levelId String?
  level   Level?  @relation(fields: [levelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([courseId, order])
  @@index([courseId, difficulty])
}

// Kurz je rozdělený na levely, kterými žák prochází postupně (podobně jako
// v Duolingu). Zatím jde jen o kostru — obsah jednotlivých levelů (lekce,
// cvičení) se bude doplňovat postupně přes `Lesson`/`LessonProgress` napojené
// na konkrétní level, případně přímo v poli `content` až přijde čas.
model Level {
  id        String  @id @default(cuid())
  title     String
  order     Int     @default(0)
  published Boolean @default(false)

  questions Question[]

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, order])
}

model Lesson {
  id       String @id @default(cuid())
  title    String
  slug     String
  content  String // markdown/HTML content
  order    Int    @default(0)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  progress LessonProgress[]

  @@unique([courseId, slug])
}

model Enrollment {
  id       String   @id @default(cuid())
  userId   String
  courseId String
  enrolledAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

// --- Bodový systém ---

// Každá změna bodů (dokončená lekce, kvíz, denní bonus, budoucí odměny…)
// se zapíše sem jako jeden řádek. User.points je běžící součet pro rychlé
// čtení; tahle tabulka drží historii a je místo, kam se dá připojit
// cokoliv dalšího (typy odměn, vypršení bodů, žebříčky apod.).
model PointTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int // kladné = přičtení, záporné = odečtení
  reason    String // např. "Dokončená lekce", "Bonus za přihlášení"
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// --- Živé třídní hry (Kahoot/Blooket styl) ---
// Místnost založí kdokoliv; kdo ji založil, je v ní učitel. Otázky se při založení zkopírují do `questions`,
// takže se hra nemění, když se upraví kurz, a hráči nikdy nedostanou správné odpovědi dřív než při odhalení.

// Vlastní sada otázek přihlášeného uživatele. `questions` je pole { prompt, options[4], correctIndex, explanation? }.
model QuestionSet {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title     String
  questions Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, updatedAt])
}

// mode: QUIZ | RACE | GOLD. status: LOBBY | QUESTION | REVEAL | ENDED (skutečný stav se dopočítává z času).
model LiveRoom {
  id                String    @id @default(cuid())
  pin               String    @unique
  hostSecret        String
  hostUserId        String?
  hostUser          User?     @relation(fields: [hostUserId], references: [id], onDelete: SetNull)
  title             String
  mode              String
  status            String    @default("LOBBY")
  questions         Json
  settings          Json
  current           Int       @default(-1)
  questionStartedAt DateTime?
  endsAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  players LivePlayer[]
  answers LiveAnswer[]

  @@index([createdAt])
}

model LivePlayer {
  id           String   @id @default(cuid())
  roomId       String
  room         LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  name         String
  token        String
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  avatar       String?
  score        Int      @default(0)
  gold         Int      @default(0)
  progress     Int      @default(0)
  answered     Int      @default(0)
  streak       Int      @default(0)
  pendingChest Json?
  // Odměna za dohranou hru (jen přihlášení hráči); null = ještě nevyplaceno.
  rewardXp     Int?
  rewardPoints Int?
  joinedAt     DateTime @default(now())

  answers LiveAnswer[]

  @@unique([roomId, name])
  @@index([roomId, score])
}

model LiveAnswer {
  id        String     @id @default(cuid())
  roomId    String
  room      LiveRoom   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  playerId  String
  player    LivePlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  qIndex    Int
  seq       Int
  choice    Int
  correct   Boolean
  ms        Int
  points    Int        @default(0)
  createdAt DateTime   @default(now())

  @@unique([playerId, seq])
  @@index([roomId, qIndex])
}
