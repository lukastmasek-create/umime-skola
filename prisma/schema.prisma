generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Auth (NextAuth / Auth.js) ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String? // hashed password, for credentials login
  role          Role      @default(STUDENT)

  // Bodový systém — aktuální zůstatek bodů. Historie je v PointTransaction,
  // takže sem lze později přidat odznaky, žebříčky, odměny apod.
  points Int @default(0)

  // Kdy uživatel naposledy roztočil kolo štěstí v obchodě (pro denní limit).
  lastWheelSpinAt DateTime?

  // Škola hráče pro školní žebříčky.
  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  // Vybraný avatar (id z src/lib/avatars.ts). Fotky se nenahrávají.
  avatar   String?
  title    String?
  xpEvents XpEvent[]
  unlocks     Unlock[]
  escapeRuns  EscapeRun[]
  idleStates  IdleState[]

  accounts Account[]
  sessions Session[]

  enrollments      Enrollment[]
  progress         LessonProgress[]
  pointTransactions PointTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

// Zkušenosti (XP) pro úrovně. XP je součet všech záznamů hráče, takže se
// nikdy nesnižuje utrácením bodů a dá se u každého záznamu dohledat zdroj
// (kolo štěstí, hra, test…) a hlídat denní limity.
model XpEvent {
  id        String   @id @default(cuid())
  amount    Int
  source    String
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Odemčené odměny (avatary a tituly získané událostmi nebo úspěchy).
// `key` má tvar "avatar:chemik" nebo "title:heisenberg".
model Unlock {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

// Jeden dokončený pokus o únikovku (pro žebříčky nejrychlejších časů).
model EscapeRun {
  id        String   @id @default(cuid())
  room      String
  seconds   Int
  stars     Int
  mistakes  Int
  hints     Int
  relaxed   Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, room])
  @@index([room, seconds])
}

// Uložený postup ve stálé hře (Mazlíčci, později Základna, Farma, Město).
// `game` je id hry, `data` je JSON stav, který si hra sama validuje.
model IdleState {
  id        String   @id @default(cuid())
  game      String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, game])
}

// Škola pro školní žebříčky (lokální žebříček i škola vs škola). `city` je
// prázdný řetězec, když ho hráč nevyplní, aby šlo hlídat unikátnost.
model School {
  id        String   @id @default(cuid())
  name      String
  city      String   @default("")
  createdAt DateTime @default(now())

  users User[]

  @@unique([name, city])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Education domain ---

// Sekce webu: základní škola, střední škola, přípravy na přijímačky, maturita.
enum Category {
  ZAKLADNI
  STREDNI
  PRIJIMACKY
  MATURITA
}

// Jazyky/předměty, podle kterých lze kurzy filtrovat. Snadno rozšiřitelné
// o další zkratky podle potřeby.
enum Language {
  CJ // Český jazyk
  NJ // Německý jazyk
  RS // Ruský jazyk
  AJ // Anglický jazyk
}

// Předmět, pod který kurz spadá (záložky uvnitř sekce typu školy).
enum Subject {
  CESTINA
  LITERATURA
  ANGLICTINA
  NEMCINA
  RUSTINA
  MATEMATIKA
  DEJEPIS
  ZEMEPIS
  PRIRODOPIS
}

// Kurz = jedno téma (např. "i/y", "Druhá světová válka", "Savci"), které se
// procvičuje hrou. `section` je kategorie/obor uvnitř předmětu.
model Course {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String?
  published   Boolean   @default(false)
  category    Category
  language    Language?
  subject     Subject?
  section     String?
  grade       Int?

  levels      Level[]
  lessons     Lesson[]
  questions   Question[]
  enrollments Enrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, language])
  @@index([category, subject])
  @@index([category, grade])
}

// Otázka kurzu používaná hrami (Space Invaders atd.). `options` má 4 možnosti,
// `correctIndex` je index správné, `explanation` vysvětluje proč.
model Question {
  id           String   @id @default(cuid())
  prompt       String
  options      String[]
  correctIndex Int
  explanation  String
  difficulty   Int      @default(1)
  answers      String[]
  hint         String?
  order        Int      @default(0)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  levelId String?
  level   Level?  @relation(fields: [levelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([courseId, order])
  @@index([courseId, difficulty])
}

// Kurz je rozdělený na levely, kterými žák prochází postupně (podobně jako
// v Duolingu). Zatím jde jen o kostru — obsah jednotlivých levelů (lekce,
// cvičení) se bude doplňovat postupně přes `Lesson`/`LessonProgress` napojené
// na konkrétní level, případně přímo v poli `content` až přijde čas.
model Level {
  id        String  @id @default(cuid())
  title     String
  order     Int     @default(0)
  published Boolean @default(false)

  questions Question[]

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, order])
}

model Lesson {
  id       String @id @default(cuid())
  title    String
  slug     String
  content  String // markdown/HTML content
  order    Int    @default(0)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  progress LessonProgress[]

  @@unique([courseId, slug])
}

model Enrollment {
  id       String   @id @default(cuid())
  userId   String
  courseId String
  enrolledAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

// --- Bodový systém ---

// Každá změna bodů (dokončená lekce, kvíz, denní bonus, budoucí odměny…)
// se zapíše sem jako jeden řádek. User.points je běžící součet pro rychlé
// čtení; tahle tabulka drží historii a je místo, kam se dá připojit
// cokoliv dalšího (typy odměn, vypršení bodů, žebříčky apod.).
model PointTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int // kladné = přičtení, záporné = odečtení
  reason    String // např. "Dokončená lekce", "Bonus za přihlášení"
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
