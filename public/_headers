# Hlavičky pro statické soubory, které Workers Static Assets servíruje bez workeru
# (Next config headers() se na ně nevztahuje). Formát: https://developers.cloudflare.com/workers/static-assets/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains

# Soubory s hashem v názvu se nikdy nemění.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Obrázky, modely a další soubory z public/ bez hashe: den v prohlížeči, týden na CDN.
/home/*
  Cache-Control: public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400
