# Databáze (PostgreSQL) — na Render/Vercel/Supabase apod.
DATABASE_URL="postgresql://user:password@localhost:5432/edu_site"

# NextAuth
# Vygeneruj náhodný string: `openssl rand -base64 32`
AUTH_SECRET="change-me"

# Volitelné (na Cloudflare nastav AUTH_URL na https://ucimesehrou.org)
# AUTH_URL="http://localhost:3000"

# E-mail týmu podpory pro zprávy z /kontakt jde přes Cloudflare Email Service (binding EMAIL ve wrangler.jsonc).
# Lokálně se e-mail přeskočí, protože binding tu není. Adresy jsou nastavené ve wrangler.jsonc (vars).
