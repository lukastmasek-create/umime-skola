# Databáze (PostgreSQL) — na Render/Vercel/Supabase apod.
DATABASE_URL="postgresql://user:password@localhost:5432/edu_site"

# NextAuth
# Vygeneruj náhodný string: `openssl rand -base64 32`
AUTH_SECRET="change-me"

# Volitelné (na Cloudflare nastav AUTH_URL na https://ucimesehrou.org)
# AUTH_URL="http://localhost:3000"

# E-mail týmu podpory pro zprávy z /kontakt (Resend). Bez nich se e-mail jen přeskočí.
# RESEND_API_KEY="re_..."
# CONTACT_EMAIL_TO="ucimesehrou@seznam.cz"
# CONTACT_EMAIL_FROM="Učíme se hrou <kontakt@ucimesehrou.org>"  # doména musí být ověřená v Resend
