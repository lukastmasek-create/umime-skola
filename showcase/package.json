{
  "name": "ucimesehrou-showcase",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc",
    "render:hero": "remotion still src/index.ts hero-16x9 previews/hero-16x9.png --gl=angle && remotion still src/index.ts hero-9x16 previews/hero-9x16.png --gl=angle",
    "render:all": "node scripts/render.mjs all --both",
    "render:all:16x9": "node scripts/render.mjs all",
    "render:all:9x16": "node scripts/render.mjs all --vertical",
    "preview:all": "node scripts/render.mjs all --preview",
    "verify": "node scripts/verify.mjs renders",
    "verify:previews": "node scripts/verify.mjs previews",
    "capture": "node capture/capture.mjs",
    "capture:strips": "node capture/strips.mjs",
    "capture:logo": "node capture/logo.mjs",
    "capture:gated": "node capture/gated.mjs && node capture/states.mjs && node capture/economy.mjs",
    "render:intro": "node scripts/render.mjs intro --both",
    "preview:intro": "node scripts/render.mjs intro --preview",
    "render:home": "node scripts/render.mjs home --both",
    "preview:home": "node scripts/render.mjs home --preview",
    "render:courses": "node scripts/render.mjs courses --both",
    "preview:courses": "node scripts/render.mjs courses --preview",
    "render:lessons": "node scripts/render.mjs lessons --both",
    "preview:lessons": "node scripts/render.mjs lessons --preview",
    "render:multiplayer": "node scripts/render.mjs multiplayer --both",
    "preview:multiplayer": "node scripts/render.mjs multiplayer --preview",
    "render:hub": "node scripts/render.mjs hub --both",
    "preview:hub": "node scripts/render.mjs hub --preview",
    "render:farma": "node scripts/render.mjs farma --both",
    "preview:farma": "node scripts/render.mjs farma --preview",
    "render:mesto": "node scripts/render.mjs mesto --both",
    "preview:mesto": "node scripts/render.mjs mesto --preview",
    "render:zakladna": "node scripts/render.mjs zakladna --both",
    "preview:zakladna": "node scripts/render.mjs zakladna --preview",
    "render:economy": "node scripts/render.mjs economy --both",
    "preview:economy": "node scripts/render.mjs economy --preview",
    "render:teams": "node scripts/render.mjs teams --both",
    "preview:teams": "node scripts/render.mjs teams --preview",
    "render:teachers": "node scripts/render.mjs teachers --both",
    "preview:teachers": "node scripts/render.mjs teachers --preview",
    "render:finale": "node scripts/render.mjs finale --both",
    "preview:finale": "node scripts/render.mjs finale --preview",
    "render:master": "node scripts/render.mjs master --both",
    "preview:master": "node scripts/render.mjs master --preview"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "@remotion/bundler": "^4.0.290",
    "@remotion/cli": "^4.0.290",
    "@remotion/renderer": "^4.0.290",
    "@remotion/three": "^4.0.290",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.290",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/three": "^0.187.0",
    "typescript": "^5.7.3"
  }
}