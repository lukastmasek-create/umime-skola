{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ucimesehrou",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "AUTH_TRUST_HOST": "true",
    "CONTACT_EMAIL_TO": "ucimesehrou@seznam.cz"
  },
  "observability": {
    "enabled": true
  },
  // Připojení k externímu PostgreSQL přes Hyperdrive.
  // Id vytvoř příkazem: npx wrangler hyperdrive create <nazev> --connection-string="postgresql://..."
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "9e8b00071af14ddda614134d726074fe",
      "localConnectionString": "postgresql://postgres:postgres@localhost:5432/postgres"
    }
  ],
  // Vlastní doména ucimesehrou.org (zóna musí být v účtu Cloudflare).
  "routes": [
    { "pattern": "ucimesehrou.org", "custom_domain": true }
  ]
}
